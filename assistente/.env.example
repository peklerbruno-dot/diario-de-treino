# Banco (Vercel → Storage → Postgres → .env.local → Copy Snippet). Cole o
# snippet inteiro: no Neon ele traz também a DATABASE_URL_UNPOOLED, usada só
# para criar as tabelas.
DATABASE_URL="postgresql://..."
# DATABASE_URL_UNPOOLED="postgresql://..."

# Claude (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY="sk-ant-..."
# Opcionais: o modelo e quanto ele pensa (low, medium, high).
# ANTHROPIC_MODELO="claude-opus-5"
# ANTHROPIC_ESFORCO="medium"

# WhatsApp Cloud API (developers.facebook.com → seu app → WhatsApp → API Setup).
WHATSAPP_TOKEN="EAAG..."
WHATSAPP_NUMERO_ID="123456789012345"
# Você inventa; é o mesmo texto que vai no campo "Verify token" do webhook.
WHATSAPP_TOKEN_VERIFICACAO="invente-um-texto"
# Configurações do app → Básico → Chave secreta do app.
META_APP_SECRET="..."

# O único número que o assistente atende: o seu, com DDI e DDD.
DONO_WHATSAPP="5511912345678"
# Como ele chama você.
DONO_NOME="Seu nome"

# A senha do relógio dos lembretes (qualquer texto longo e aleatório).
CRON_SECRET="troque-por-um-texto-longo"

# Opcional: o modelo aprovado que leva lembretes depois de 24 h sem conversa.
# WHATSAPP_MODELO_LEMBRETE="lembrete"
# WHATSAPP_MODELO_IDIOMA="pt_BR"

# Opcional: o fuso dos horários (padrão America/Sao_Paulo).
# FUSO="America/Sao_Paulo"
