# Copie para .env e preencha. O .env não vai para o repositório.

# O banco. Em desenvolvimento, qualquer Postgres serve.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/cej"

# Só a migração usa esta: é a conexão sem intermediário, que criar tabela exige.
# Num Postgres comum ela não é necessária; na Vercel vem junto no snippet.
# DATABASE_URL_UNPOOLED="postgresql://..."

# Assina o cookie de sessão. Um texto longo e aleatório; trocá-lo derruba todas
# as sessões de uma vez, que é o botão de pânico caso um computador se perca.
AUTH_SECRET="troque-isto-por-um-texto-longo-e-aleatorio"

# Libera a criação da PRIMEIRA conta, e só enquanto não houver ninguém.
CODIGO_DE_FUNDACAO="uma-senha-so-sua-usada-uma-vez"

# --- O envio de boletins (opcional) ----------------------------------------
# Sem estas, o sistema inteiro funciona; só o disparo de e-mail fica de fora.
# O passo a passo está em docs/BOLETIM.md.
# RESEND_API_KEY="re_..."
# EMAIL_REMETENTE="Centro de Estudos Judaicos <boletim@seu-dominio.org>"
# EMAIL_RESPONDER_PARA="cej@usp.br"

# Só para testar o envio contra um servidor de mentira, em desenvolvimento.
# É ignorada em produção de propósito: uma variável mal preenchida no painel
# faria os boletins saírem para o vazio em silêncio.
# EMAIL_API_BASE="http://localhost:9999"
