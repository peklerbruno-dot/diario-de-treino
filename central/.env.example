# Banco (o snippet do Postgres da Vercel traz as duas)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Login: o código que você digita, e o segredo que assina a sessão e cifra os tokens
CODIGO_DE_ACESSO=
AUTH_SECRET=

# Google Cloud → Credenciais → ID do cliente OAuth (Aplicativo da Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# O endereço público, sem barra no fim. O retorno do OAuth é APP_URL/api/google/retorno
APP_URL=

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Opcional: claude-sonnet-5-5 custa uns 50% menos
CLAUDE_MODELO=

# A Vercel manda este segredo na atualização automática diária
CRON_SECRET=
