// A Central guarda pouco: as contas conectadas, o que a triagem concluiu de
// cada conversa e o que você ensinou a ela. O texto dos e-mails não fica aqui —
// mora no Gmail e é lido de lá na hora em que a tela precisa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Só a conexão do dia a dia. A conexão direta, que a migração exige no Neon,
  // é escolhida pelo scripts/build-vercel.mjs, sem ser obrigatória aqui: um
  // directUrl no schema derrubava o build de quem não tinha essa variável.
  url      = env("DATABASE_URL")
}

/// Uma conta Google conectada: Pessoal, CIP, USP…
model Conta {
  id              String    @id @default(cuid())
  email           String    @unique
  /// O nome curto que aparece nas etiquetas ("CIP", "USP", "Pessoal").
  rotulo          String
  /// Cifrado com o AUTH_SECRET (ver src/lib/cofre.ts).
  refreshToken    String
  accessToken     String?
  accessExpiraEm  DateTime?
  /// Como você escreve, aprendido dos seus e-mails enviados.
  estilo          String?
  /// Preenchido quando o Google recusou o acesso e é preciso reconectar.
  erro            String?
  ultimaSincronia DateTime?
  criadoEm        DateTime  @default(now())
  conversas       Conversa[]
}

/// Uma conversa (thread) do Gmail e o que a triagem concluiu dela.
model Conversa {
  id                 String    @id @default(cuid())
  contaId            String
  conta              Conta     @relation(fields: [contaId], references: [id], onDelete: Cascade)
  threadId           String
  assunto            String
  remetente          String
  remetenteEmail     String
  trecho             String
  ultimaData         DateTime
  /// A última mensagem é sua? Então, se houver algo, é a vez do outro.
  ultimaDeMim        Boolean   @default(false)
  /// Id da última mensagem já classificada. Mudou, classifica de novo.
  ultimaMensagemId   String
  classificadaMsgId  String?
  categoria          String    @default("informativo")
  /// 1 = urgente, 2 = normal, 3 = pode esperar.
  prioridade         Int       @default(2)
  resumo             String    @default("")
  proximaAcao        String    @default("")
  prazo              DateTime?
  /// Você corrigiu a categoria à mão: a triagem não a troca mais.
  corrigida          Boolean   @default(false)
  /// Marcada como resolvida aqui na Central. Volta se chegar mensagem nova.
  resolvida          Boolean   @default(false)
  /// Está na caixa de entrada do Gmail. Arquivou lá, some daqui — menos as
  /// que esperam resposta dos outros, que vêm dos enviados.
  naCaixa            Boolean   @default(true)
  /// Um compromisso proposto no e-mail (convite, reunião marcada), para virar
  /// evento na agenda com um clique. Só existe quando há data e hora concretas.
  eventoTitulo       String?
  eventoInicio       DateTime?
  eventoFim          DateTime?
  /// O dossiê da pendência (por quê, linha do tempo, combinado, falta),
  /// gerado quando você abre a conversa e refeito só se chegar mensagem nova.
  dossie             Json?
  dossieMsgId        String?
  atualizadoEm       DateTime  @updatedAt
  rascunhos          Rascunho[]

  @@unique([contaId, threadId])
  @@index([categoria, resolvida])
}

model Rascunho {
  id           String   @id @default(cuid())
  conversaId   String
  conversa     Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  contexto     String   @default("")
  texto        String
  gmailDraftId String?
  criadoEm     DateTime @default(now())
}

/// Uma regra escrita por você ("tudo da Nancy é prioridade").
model Instrucao {
  id       String   @id @default(cuid())
  texto    String
  criadoEm DateTime @default(now())
}

/// Cada correção de categoria vira exemplo para as próximas triagens.
model Correcao {
  id             String   @id @default(cuid())
  remetenteEmail String
  assunto        String
  de             String
  para           String
  criadoEm       DateTime @default(now())
}

/// Uma tarefa sua, escrita à mão. As que vêm dos e-mails não ficam aqui:
/// são a "próxima ação" de cada conversa, e marcá-las resolve a conversa.
model Tarefa {
  id       String    @id @default(cuid())
  titulo   String
  /// Só o dia (meia-noite UTC), como os prazos das conversas.
  prazo    DateTime?
  /// O porquê da tarefa, nas suas palavras.
  nota     String?
  feitaEm  DateTime?
  criadoEm DateTime  @default(now())

  @@index([feitaEm])
}

/// Preferências simples, chave e valor (o resumo da manhã, por exemplo).
model Ajuste {
  chave String @id
  valor String
}

/// O que você anotou sobre uma pessoa. O resto (quantas conversas, o que está
/// em aberto) se calcula das conversas, na hora.
model Contato {
  email      String   @id
  nota       String   @default("")
  atualizado DateTime @updatedAt
}
