# Endereço do banco (Vercel → Storage → Neon/Postgres → .env.local → Copy Snippet).
# Cole o snippet inteiro: no Neon ele traz também a DATABASE_URL_UNPOOLED, que
# é a conexão sem intermediário usada só para criar e alterar tabelas.
DATABASE_URL="postgresql://..."
# DATABASE_URL_UNPOOLED="postgresql://..."

# Texto comprido e aleatório. Ninguém digita: é o que assina o cookie de sessão.
AUTH_SECRET="troque-por-um-texto-longo-e-aleatorio-de-32-letras-ou-mais"

# A porta do app: o código que você digita para entrar.
CODIGO_DE_ACESSO="escolha-um-codigo"

# As chaves das notificações. A tela Ajustes do app mostra um par pronto para
# copiar enquanto elas não existem (ou rode `npm run chaves`).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:seu-email@exemplo.com"

# Senha do relógio: o cron-job.org chama /api/avisos?chave=ESTE_VALOR a cada minuto.
CRON_SECRET="outro-texto-aleatorio"

# Leitura do PDF/foto do plano. Grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=""
