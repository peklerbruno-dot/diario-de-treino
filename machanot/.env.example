# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/machanot?schema=public"

# Segredo usado para assinar os cookies de sessao. Troque em producao.
AUTH_SECRET="troque-este-valor-em-producao-com-32-caracteres-ou-mais"

# E-mails autorizados a entrar na plataforma, separados por virgula.
# Vazio = qualquer e-mail pode pedir link (nao recomendado em producao).
EMAILS_AUTORIZADOS="coordenacao@chazit.org.br"

# Em desenvolvimento o link magico e impresso no terminal e devolvido na tela.
# Em producao configure um provedor de e-mail em src/lib/email.ts.
NODE_ENV="development"
