# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/machanot?schema=public"

# Segredo usado para assinar os cookies de sessao. Troque em producao.
AUTH_SECRET="troque-este-valor-em-producao-com-32-caracteres-ou-mais"

# O codigo que a coordenacao digita para entrar. E a unica porta da plataforma:
# quem sabe o codigo entra. Troque quando a coordenacao mudar.
CODIGO_DE_ACESSO=""

NODE_ENV="development"
